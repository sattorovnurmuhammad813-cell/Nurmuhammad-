# --- Telegram Bot API ---
# @BotFather'dan olingan (eski token oshkor bo'lgani uchun /revoke qilib, YANGISINI oling)
BOT_TOKEN=

# --- Telegram MTProto (marketplace narxlarini o'qish uchun, oddiy user akkaunt) ---
# https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# `npm run session` buyrug'ini FAQAT o'zingizning lokal kompyuteringizda ishga
# tushiring (telefon raqam + SMS kod so'raladi). Natijada chiqqan qatorni bu
# faylga YOZMANG - to'g'ridan-to'g'ri Vercel Dashboard > Settings >
# Environment Variables bo'limiga qo'shing. Bu qator parolingiz kabi maxfiy!
TELEGRAM_SESSION_STRING=

# --- Himoya ---
# /api/check-gifts endpointini tashqi cron xizmati chaqirganda tekshiriladigan
# tasodifiy maxfiy so'z (o'zingiz o'ylab toping, masalan: openssl rand -hex 20)
CRON_SECRET=
# Telegram webhook so'rovlarini tekshirish uchun maxfiy so'z (setWebhook'da ham beriladi)
WEBHOOK_SECRET=

# --- Upstash Redis (bepul: https://upstash.com) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
