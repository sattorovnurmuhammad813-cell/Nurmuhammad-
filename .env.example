# --- Telegram Bot API ---
# Bot A (asosiy): @BotFather'dan olingan (eski token oshkor bo'lgani uchun /revoke qilib, YANGISINI oling)
BOT_TOKEN=

# Bot B (ikkinchi, alohida bot) - agar shu ham ishlatilsa to'ldiring, bo'lmasa bo'sh qoldiring
BOT_TOKEN_2=

# --- Telegram MTProto (marketplace narxlarini o'qish uchun, oddiy user akkaunt) ---
# https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# `npm run session` buyrug'ini FAQAT o'zingizning lokal kompyuteringizda ishga
# tushiring (telefon raqam + SMS kod so'raladi). Natijada chiqqan qatorni bu
# faylga YOZMANG - to'g'ridan-to'g'ri Vercel Dashboard > Settings >
# Environment Variables bo'limiga qo'shing. Bu qator parolingiz kabi maxfiy!
TELEGRAM_SESSION_STRING=

# --- Himoya ---
# /api/check-gifts endpointini tashqi cron xizmati chaqirganda tekshiriladigan
# tasodifiy maxfiy so'z (o'zingiz o'ylab toping, masalan: openssl rand -hex 20)
CRON_SECRET=
# Telegram webhook so'rovlarini tekshirish uchun maxfiy so'z (setWebhook'da ham beriladi)
WEBHOOK_SECRET=
# Bot B uchun xuddi shunday, alohida maxfiy so'z
WEBHOOK_SECRET_2=
# Botga buyruq/callback yubora oladigan chat_id'lar ro'yxati (vergul bilan
# ajratilgan, masalan: 111111111,222222222). Bo'sh qoldirilsa - cheklovsiz
# (har kim /start yozib botni ishlata oladi). Auto-buy HAQIQIY xarid rejimida
# bo'lsa, kunlik limit va Stars balansi BUTUN akkaunt bo'yicha umumiy bo'lgani
# uchun shu ro'yxatni to'ldirish TAVSIYA ETILADI - aks holda begona chat ham
# kuzatuv qo'shib, sizning real pulingizni/kunlik limitingizni band qilib
# qo'yishi mumkin.
ALLOWED_CHAT_IDS=

# --- Upstash Redis (bepul: https://upstash.com) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Avtomatik xarid (worker/poll.ts) - FAQAT VPS worker'da ishlaydi ---
# XAVFLI: "true" bo'lganda va DRY_RUN "false" bo'lganda haqiqiy Stars sarflanadi!
# Standart holat har doim eng xavfsiz tomonga og'adi:
#   AUTO_BUY_ENABLED != "true"  -> funksiya butunlay o'chirilgan
#   AUTO_BUY_DRY_RUN != "false" -> hech qachon haqiqiy xarid qilinmaydi, faqat simulyatsiya
AUTO_BUY_ENABLED=false
AUTO_BUY_DRY_RUN=true
